# Dependencies
node_modules/
.bun/
bun.lockb
# bun.lock is the lockfile of record; npm's is a byproduct of the audit job.
package-lock.json

# Local credentials & configs
.env
.env.local
.env.*.local
*.log
cloudflared.log
cloudflared.exe

# Build & runtime cache
__pycache__/
*.pyc
# The Rust build tree, and the compiled Bun server the desktop bundle embeds. Both are
# outputs of `bun run desktop:build`; the release workflow rebuilds them per platform.
src-tauri/target/
src-tauri/binaries/
src-tauri/gen/
.impeccable/
reports/
.scratch/

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini

# Temporary video test outputs
video-test/


# Signing keys, and anything shaped like one. The updater's private key lives outside
# this repository on purpose — every installed copy trusts it, and losing control of it
# means someone else can sign an update the app will accept. These patterns are the
# backstop for the day a key is generated into the working tree by habit: `tauri signer
# generate` writes here unless told otherwise.
*.key
*.pem
*.p12
*.pfx
.llm-quota-keys/

# Written by `bun test --coverage --coverage-reporter=lcov`. The badge's number lives
# in docs/coverage.json; the report itself is a local artefact.
coverage/
