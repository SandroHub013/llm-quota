{
  "name": "llm-quota",
  "version": "0.3.0",
  "type": "module",
  "private": false,
  "description": "Local-first live quota dashboard, CLI, and Windows widget for Claude Code, Codex, and Gemini",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SandroHub013/llm-quota.git"
  },
  "bugs": {
    "url": "https://github.com/SandroHub013/llm-quota/issues"
  },
  "homepage": "https://sandrohub013.github.io/llm-quota/",
  "keywords": [
    "llm",
    "quota",
    "rate-limit",
    "usage",
    "dashboard",
    "cli",
    "claude-code",
    "anthropic",
    "codex",
    "openai",
    "gemini",
    "moonshot",
    "opencode",
    "local-first",
    "self-hosted",
    "privacy",
    "developer-tools",
    "ai-agents",
    "bun"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "public",
    "widget.py",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "llm-quota": "src/cli.ts",
    "webquota": "src/cli.ts"
  },
  "scripts": {
    "dev": "bun run --hot src/server.ts",
    "start": "bun run src/server.ts",
    "cli": "bun run src/cli.ts",
    "typecheck": "bun x tsc --noEmit"
  },
  "dependencies": {
    "hono": "4.10.7"
  },
  "devDependencies": {
    "@types/bun": "1.3.7",
    "typescript": "5.8.2"
  }
