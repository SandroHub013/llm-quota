# Every environment variable LLM Quota reads. Names only — this file is committed,
# so it must never hold a value that matters.
#
# Nothing here is a credential. Provider API keys are entered in the dashboard and
# stored in ~/.llm-quota/config.json at mode 0600; they are deliberately not read
# from the environment, so a key cannot end up in a shell history or a process list.
#
# The project does not load a .env file on its own — it reads the process
# environment. Export these, or use your shell's own dotenv support.

# Port the local server binds on 127.0.0.1. Default: 4747.
PORT=

# Base URL the CLI and the desktop widget use to reach that server.
# Default: http://localhost:4747
LLM_QUOTA_URL=

# Pre-rename alias for LLM_QUOTA_URL, still honoured. Prefer the name above.
WEBQUOTA_URL=

# Set to 1 to silence the handled-failure warnings the server prints to stderr.
# Only the diagnostics are suppressed; behaviour is unchanged.
LLM_QUOTA_QUIET=
